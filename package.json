{
  "name": "openchamber-youtrack-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A YouTrack integration for OpenChamber.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devensoft/openchamber-youtrack-extension.git"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun test",
    "verify": "bun run build && git diff --exit-code -- panel/main.js",
    "package": "bun run scripts/package.ts",
    "bump": "bun run scripts/bump.ts"
  },
  "dependencies": {
    "@openchamber/sdk": "2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "youtrack",
        "name": "YouTrack",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      }
    }
  }
}
